# PostgreSQL (Neon). DATABASE_URL is the pooled connection (runtime),
# DIRECT_URL is the unpooled connection (used by Prisma Migrate).
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?channel_binding=require&sslmode=require"
DIRECT_URL="postgresql://user:password@host.region.aws.neon.tech/dbname?channel_binding=require&sslmode=require"

# Auth.js (NextAuth v5)
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# Email (used for verification links, expiry/payment-reminder notifications)
EMAIL_API_KEY=""

# Shared secret checked on the notifications cron Route Handler
CRON_SECRET=""

# Separate Neon branch used only by tenant-isolation/integration tests
TEST_DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?channel_binding=require&sslmode=require"
