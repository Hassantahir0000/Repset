// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Tenant core
// ---------------------------------------------------------------------------

enum OrganizationStatus {
  TRIAL
  ACTIVE
  SUSPENDED
}

model Organization {
  id        String             @id @default(cuid())
  name      String
  slug      String             @unique
  timezone  String             @default("UTC")
  currency  String             @default("USD")
  status    OrganizationStatus @default(TRIAL)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  branches        Branch[]
  users           User[]
  members         Member[]
  membershipPlans MembershipPlan[]
  memberships     Membership[]
  attendances     Attendance[]

  @@map("organizations")
}

model Branch {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  address        String?
  phone          String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  users           User[]
  members         Member[]
  membershipPlans MembershipPlan[]
  memberships     Membership[]
  attendances     Attendance[]

  @@index([organizationId])
  @@map("branches")
}

enum Role {
  OWNER
  BRANCH_MANAGER
  RECEPTIONIST
  TRAINER
  ACCOUNTANT
}

model User {
  id             String    @id @default(cuid())
  organizationId String
  branchId       String?
  email          String
  passwordHash   String
  name           String
  role           Role      @default(OWNER)
  isActive       Boolean   @default(true)
  emailVerified  DateTime?
  mfaEnabled     Boolean   @default(false)
  mfaSecret      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  accounts     Account[]
  sessions     Session[]

  @@unique([organizationId, email])
  @@index([organizationId])
  @@index([organizationId, branchId])
  @@map("users")
}

// ---------------------------------------------------------------------------
// Members
// ---------------------------------------------------------------------------

enum MemberStatus {
  ACTIVE
  INACTIVE
  FROZEN
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

model Member {
  id             String       @id @default(cuid())
  organizationId String
  branchId       String
  memberCode     String
  firstName      String
  lastName       String
  email          String?
  phone          String
  dateOfBirth    DateTime?
  gender         Gender?
  address        String?
  photoUrl       String?      @db.Text
  status         MemberStatus @default(ACTIVE)
  joinedAt       DateTime     @default(now())
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  memberships  Membership[]
  attendances  Attendance[]

  @@unique([organizationId, memberCode])
  @@index([organizationId])
  @@index([organizationId, branchId])
  @@map("members")
}

// ---------------------------------------------------------------------------
// Memberships
// ---------------------------------------------------------------------------

enum MembershipDurationType {
  MONTHLY
  QUARTERLY
  ANNUAL
  CUSTOM
}

// branchId is nullable here (a plan can be org-wide or scoped to one branch),
// unlike Member/Membership where a branch is always required.
model MembershipPlan {
  id              String                 @id @default(cuid())
  organizationId  String
  branchId        String?
  name            String
  durationType    MembershipDurationType
  durationDays    Int
  price           Decimal                @db.Decimal(10, 2)
  registrationFee Decimal                @default(0) @db.Decimal(10, 2)
  isActive        Boolean                @default(true)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch?      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  memberships  Membership[]

  @@index([organizationId])
  @@index([organizationId, branchId])
  @@map("membership_plans")
}

enum MembershipStatus {
  PENDING
  ACTIVE
  FROZEN
  EXPIRED
  CANCELLED
}

model Membership {
  id              String           @id @default(cuid())
  organizationId  String
  branchId        String
  memberId        String
  planId          String
  status          MembershipStatus @default(ACTIVE)
  startDate       DateTime
  endDate         DateTime
  autoRenew       Boolean          @default(false)
  priceAtPurchase Decimal          @db.Decimal(10, 2)
  frozenAt        DateTime?
  freezeResumeAt  DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch         @relation(fields: [branchId], references: [id], onDelete: Restrict)
  member       Member         @relation(fields: [memberId], references: [id], onDelete: Cascade)
  plan         MembershipPlan @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([organizationId, branchId])
  @@index([memberId])
  @@map("memberships")
}

// ---------------------------------------------------------------------------
// Attendance
// ---------------------------------------------------------------------------

enum CheckInMethod {
  MANUAL
  QR
}

model Attendance {
  id             String        @id @default(cuid())
  organizationId String
  branchId       String
  memberId       String
  checkInAt      DateTime      @default(now())
  checkOutAt     DateTime?
  method         CheckInMethod @default(MANUAL)
  createdAt      DateTime      @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  member       Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([organizationId, branchId, checkInAt])
  @@index([memberId])
  @@map("attendances")
}

// ---------------------------------------------------------------------------
// NextAuth (Auth.js) adapter models — not tenant-scoped, standard adapter shape
// ---------------------------------------------------------------------------

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}
